# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials. Claude does not ask for or handle these
# values in conversation; fill them in yourself.
#
# These five values are all you provide. The scripts derive the rest (SSA id, key id, PEM file under
# ~/.aps, signing key). Get the client id and secret from an APS app at https://aps.autodesk.com/myapps
# with Design Automation + Data Management API access enabled.

APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Forgeapps nickname (owner prefix for AppBundle/Activity IDs). Set once per APS app; if the app already
# has one the scripts use it. Letters, digits, underscore; up to 20 characters; no hyphen.
APS_NICKNAME=

# Only for Forma input. The SSA email is <first>-<last>@<client id>.adskserviceaccount.com. An
# existing account with that email is reused; otherwise it is created.
SSA_FIRST_NAME=
SSA_LAST_NAME=
