# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials. Claude does not ask for or handle these
# values in conversation; fill them in yourself, then run Deploy-And-Test-DA.ps1.
#
# Get these from an APS app at https://aps.autodesk.com/myapps — the app needs
# Design Automation + Data Management API access enabled.

APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Your forgeapps nickname (owner prefix for AppBundle/Activity IDs). A nickname
# can only be registered ONCE per APS app — if your app already has one,
# Deploy-And-Test-DA.ps1 detects and uses it automatically, ignoring this value.
# Only used to REGISTER a nickname the first time your app has none yet. If
# blank and no nickname exists yet, you'll be prompted on first run.
APS_NICKNAME=

# --- Secure Service Account (SSA), only needed to read or write ACC/Forma files ---
# Keep the private key as a PEM file OUTSIDE the repo; put only its path here.
APS_SSA_SERVICE_ACCOUNT_ID=
APS_SSA_KEY_ID=
APS_SSA_PRIVATE_KEY_PATH=
